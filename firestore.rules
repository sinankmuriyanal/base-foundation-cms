rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All writes go through the Admin SDK in API routes (which bypasses these rules).
    // The client SDK is only used for sign-in, so direct writes are limited to admin-claim users.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /blogs/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
