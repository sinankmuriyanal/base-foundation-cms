rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /blogs/{id} {
      allow read: if resource.data.published == true;
      allow write: if request.auth != null;
    }
    match /gallery/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
